datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id               String   @id @default(uuid())
  name             String
  companyName      String   @map("company_name")
  tin              String
  platformType     String   @map("platform_type") // legacy primary ERP; use tenantErps for multi-ERP; implicit citta tenant only for citta_efs_key
  marketTier       String   @map("market_tier")
  cittaApiKey      String   @default("sk_live_lNZAJM5WajKYQVBo3atXDNXxM33ijmAt4Xsj7lUz") @map("citta_api_key") // hub citta_efs_key — only implicit tenant for CittaEFS
  encryptedSecret  String?  @map("encrypted_secret")
  onboardingStatus String   @map("onboarding_status")
  monthlyAllowance Int      @default(1000) @map("monthly_allowance")
  monthlyUsed      Int      @default(0) @map("monthly_used")
  defaultVatRate   Float    @default(7.5) @map("default_vat_rate")
  cittaGatewayUrl  String?  @map("citta_gateway_url")
  cittaWritebackTarget String @default("BOTH") @map("citta_writeback_target") // HUB | CITTAEFS | BOTH — default BOTH so Hub invoices forward to CittaEFS
  erpConfig        String?  @map("erp_config") // JSON string per-ERP config & matching rules (legacy single)
  lastSyncAt       DateTime @default(now()) @map("last_sync_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  customers        Customer[]
  items            Item[]
  invoices         Invoice[]
  auditLogs        AuditLog[]
  validationErrors ValidationError[]
  users            User[]
  integrations     Integration[]
  queueJobs        QueueJob[]
  tenantErps       TenantErp[]
  entityMappings   EntityMapping[]

  @@map("tenants")
}

model TenantErp {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  platformType String   @map("platform_type") // e.g. "QuickBooks Online", "Odoo ERP"
  erpId        String   @map("erp_id") // e.g. qbo, odoo
  companyId    String?  @map("company_id") // realmId (QBO) or database (Odoo) — independent, tolerant until migration
  displayName  String?  @map("display_name")
  config       String?  @map("config") // JSON per-ERP config (realmId, odooUrl, etc.)
  autoEnqueueQbo Boolean @default(true) @map("auto_enqueue_qbo") // when true sync auto-enqueues to CittaEFS; gateway default true (was false)
  status       String   @default("ACTIVE") @map("status") // ACTIVE | INACTIVE | NEEDS_REAUTH
  lastSyncAt   DateTime? @map("last_sync_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, erpId, companyId])
  @@index([tenantId])
  @@index([companyId])
  @@map("tenant_erps")
}

/// DEPRECATED (thin-hub pivot, see docs/CittaHub_Revision_Plan.md Phase 1).
/// CittaEFS is the source of truth for registered customers — there is no
/// registration API, only its own Excel bulk-upload templates. This table
/// is kept only so existing rows/reads don't break during the transition;
/// new code should read/write EntityMapping (entityType: CUSTOMER) instead.
/// Do not add new writers to this model. Slated for removal once
/// EntityMapping is fully rolled out (Phase 6).
model Customer {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  clientSystemCustId String   @map("client_system_cust_id")
  companyName        String   @map("company_name")
  email              String?
  ccEmail            String?  @map("cc_email")
  postcode           String?  @map("postcode")
  taxId              String?  @map("tax_id")
  taxClassification  String   @default("B2B") @map("tax_classification")
  street             String?
  city               String?
  country            String?
  countryCode        String    @default("NGA") @map("country_code")
  stateCode          String?   @map("state_code") // NG-LA etc.
  localGovernmentCode String?  @map("local_government_code") // NG-LA-ETI etc.
  cittaCustomerId    String?  @map("citta_customer_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, clientSystemCustId])
  @@map("customers")
}

/// DEPRECATED (thin-hub pivot, see docs/CittaHub_Revision_Plan.md Phase 1).
/// Same status as Customer above — CittaEFS owns item registration.
/// New code should read/write EntityMapping (entityType: ITEM) instead.
model Item {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  clientSku       String   @map("client_sku")
  name            String?
  description     String
  unitCode        String   @default("EA") @map("unit_code")
  hsOrServiceCode String   @map("hs_or_service_code")
  categoryType    String   @default("GOODS") @map("category_type")
  defaultVatRate  Float    @default(7.5) @map("default_vat_rate")
  taxCategoryCode String?  @map("tax_category_code") // NRS Nigeria: STANDARD_VAT, EXEMPT, ZERO_RATED etc.
  productCategory String?  @map("product_category")
  isService       Boolean   @default(false) @map("is_service")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, clientSku])
  @@map("items")
}

/// Tracks whether a customer or item the Hub has seen from a client ERP has
/// been registered with CittaEFS. CittaEFS has no registration API (per
/// docs/CittaHub_Section_E_Spec-5.xlsx Interface sheet) — registration
/// happens only through its own Excel bulk-upload templates, in the EFS
/// product itself. The Hub's job is only to track a reference, not to own
/// a business-data catalog: see docs/CittaHub_Revision_Plan.md Phase 1-3.
model EntityMapping {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  entityType         String   @map("entity_type") // CUSTOMER | ITEM
  sourceErp          String   @map("source_erp") // e.g. qbo, odoo, excel — which client ERP this entity came from
  sourceErpId        String   @map("source_erp_id") // the code/ID as it exists in the client's ERP (customer code / item SKU)
  displayName        String?  @map("display_name") // human label for the registration queue UI — not a business record
  tin                String?  @map("tin") // customer TIN, if present; null for items
  detailsJson        String?  @map("details_json") // minimal snapshot captured at detection time, just enough to fill the EFS registration export (see Phase 3)
  cittaReferenceCode String?  @map("citta_reference_code") // CittaEFS_Customer_ID or EFS item code, once registered
  status             String   @default("PENDING_REGISTRATION") @map("status") // PENDING_REGISTRATION | MAPPED
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entityType, sourceErpId])
  @@index([tenantId, status])
  @@map("entity_mappings")
}

/// Internal submission/audit record, not a client-facing invoice book.
/// The Hub is a pass-through to CittaEFS/NRS (see docs/CittaHub_Revision_Plan.md);
/// this table exists so the Hub's own team can answer "did we submit this,
/// what happened" for retry, audit, and reconciliation — it is not a
/// business ledger a client would ever see or edit. No functional change
/// from the thin-hub pivot; this is a documentation-only clarification of
/// intent so future contributors don't reintroduce client-facing framing.
model Invoice {
  id                    String    @id @default(uuid())
  tenantId              String    @map("tenant_id") // implicit citta tenant for citta_efs_key
  sourceErp             String?   @map("source_erp") // e.g. qbo, odoo
  tenantErpId           String?   @map("tenant_erp_id") // FK to TenantErp connection (independent, tolerant)
  companyId             String?   @map("company_id") // realmId (QBO) or database (Odoo)
  qboInvoiceId          String?   @map("qbo_invoice_id") // immutable QBO Id when sourceErp=qbo; business key remains clientInvoiceId=DocNumber
  odooInvoiceId         String?   @map("odoo_invoice_id") // immutable Odoo account.move id when sourceErp=odoo; business key remains clientInvoiceId=name
  clientInvoiceId       String    @map("client_invoice_id")
  documentNumber        String?   @map("document_number")
  invoiceType           String    @default("STANDARD") @map("invoice_type")
  invoiceKind           String    @default("B2B") @map("invoice_kind")
  issueDate             DateTime  @map("issue_date")
  dueDate               DateTime? @map("due_date")
  customerCode          String    @map("customer_code")
  customerName          String    @map("customer_name")
  customerTin           String?   @map("customer_tin")
  currency              String    @default("NGN")
  subtotal              Float
  taxAmount             Float     @map("tax_amount")
  totalAmount           Float     @map("total_amount")
  headerDiscount        Float     @default(0) @map("header_discount")
  headerCharges         Float     @default(0) @map("header_charges")
  callbackUrl           String?   @map("callback_url") // async signed callback when NRS completes (NRS MBS pattern)
  status                String    @default("PENDING_NRS_STAMP") // PENDING until Citta verifies → APPROVED|SIGNED|REJECTED|CANCELLED
  irn                   String?   @unique
  csid                  String?
  qrCodeUrl             String?   @map("qr_code_url")
  pdfSignedUrl          String?   @map("pdf_signed_url")
  rawPayloadHash        String?   @map("raw_payload_hash")
  ledgerWritebackStatus String    @default("PENDING") @map("ledger_writeback_status") // PENDING → SYNCED|FAILED
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lineItems InvoiceLineItem[]

  @@unique([tenantId, clientInvoiceId])
  @@index([tenantId])
  @@index([companyId])
  @@index([tenantErpId])
  @@index([status])
  @@map("invoices")
}

model InvoiceLineItem {
  id              String @id @default(uuid())
  invoiceId       String @map("invoice_id")
  itemCode        String @map("item_code")
  description     String
  quantity        Float
  unitPrice       Float  @map("unit_price")
  taxableAmount   Float  @map("taxable_amount")
  vatRate         Float  @map("vat_rate")
  vatAmount       Float  @map("vat_amount")
  totalAmount     Float  @map("total_amount")
  hsOrServiceCode String @map("hs_or_service_code")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_line_items")
}

model ValidationError {
  id                  String   @id @default(uuid())
  tenantId            String   @map("tenant_id")
  clientInvoiceNumber String   @map("client_invoice_number")
  errorCategory       String   @map("error_category")
  fieldAffected       String   @map("field_affected")
  errorMessage        String   @map("error_message")
  rawPayloadSample    String   @map("raw_payload_sample")
  sourceErp           String?  @map("source_erp") // qbo | odoo | excel — which ingestion path this came from, so "resolve" knows whether it can re-run ingestion from rawPayloadSample when no Invoice was ever created (see src/routes/validation.ts)
  status              String   @default("OPEN")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("validation_errors")
}

model AuditLog {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  action            String
  entityType        String   @map("entity_type")
  entityRef         String   @map("entity_ref")
  details           String
  sha256PayloadHash String   @map("sha256_payload_hash")
  performedBy       String   @map("performed_by")
  rawJson           String?  @map("raw_json")
  createdAt         DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([sha256PayloadHash])
  @@map("audit_logs")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String?  @map("tenant_id")
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         String   @default("OPERATOR")
  organization String   @default("CittaEFS Enterprise")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("users")
}

model Integration {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  sourceSystem         String    @map("source_system") // e.g. "QUICKBOOKS_ONLINE"
  accessToken          String    @map("access_token")
  refreshToken         String    @map("refresh_token")
  companyId            String    @map("company_id") // realmId
  accessTokenExpiresAt DateTime  @map("access_token_expires_at")
  status               String    @default("CONNECTED") // "CONNECTED", "NEEDS_REAUTH", "DISCONNECTED"
  lastSyncAt           DateTime? @map("last_sync_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sourceSystem])
  @@index([tenantId])
  @@map("integrations")
}

model QueueJob {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  jobName       String   @map("job_name")
  payload       String   @map("payload") // JSON stringified QueueablePayload
  attempts      Int      @default(0)
  maxRetries    Int      @default(5) @map("max_retries")
  status        String   @default("QUEUED") // QUEUED, PROCESSING, COMPLETED, DLQ
  lastError     String?  @map("last_error")
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status, nextAttemptAt])
  @@map("queue_jobs")
}
