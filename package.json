{
  "name": "citta-gateway",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "(npm run db:migrate || echo \"[build] db:migrate advisory lock timeout — continuing (migrations will be applied at runtime)\") && node scripts/checkNoFallbacks.js && prisma generate && vite build && node scripts/buildServer.cjs",
    "start": "node start.cjs",
    "test": "node scripts/checkNoFallbacks.js && tsx src/test/verifyAll.ts",
    "test:unit": "vitest run --coverage --reporter=verbose",
    "test:gateway": "vitest run src/test/gateway.test.ts --reporter=verbose",
    "test:all": "vitest run --coverage && tsx src/test/verifyAll.ts",
    "seed": "tsx prisma/seed.ts",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:generate": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@google/genai": "^3.6.1",
    "@prisma/client": "5.22.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.26.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "nodemailer": "10.2.1",
    "prisma": "5.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "ws": "^8.21.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/nock": "^11.1.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^3.2.4",
    "nock": "^14.0.16",
    "tailwindcss": "^4.1.14",
    "vitest": "^3.2.4"
  }
}
