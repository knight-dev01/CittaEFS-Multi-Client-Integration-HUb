# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

DATABASE_URL="postgresql://cittaefs:localdev_password@localhost:5432/cittaefs_hub"

# Cloud SQL Integration (Injected by platform when enabled)
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# CittaEFS Gateway credentials (global)
CITTAEFS_API_KEY="citta_live_placeholder"
CITTAEFS_WEBHOOK_SECRET="whsec_placeholder"

# QuickBooks Online Integration Credentials
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=

# Default Admin Credentials (change these for production!)
DEFAULT_ADMIN_EMAIL=admin@cittaefs.com
DEFAULT_ADMIN_PASSWORD=Admin123!
DEFAULT_ADMIN_NAME=System Administrator
DEFAULT_ADMIN_ORG=CittaEFS Enterprise

# Optional Operator User
# DEFAULT_OPERATOR_EMAIL=operator@cittaefs.com
# DEFAULT_OPERATOR_PASSWORD=OperatorPass123!
# DEFAULT_OPERATOR_NAME=System Operator
# DEFAULT_OPERATOR_ORG=Default Organization



