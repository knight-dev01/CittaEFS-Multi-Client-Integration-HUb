# ============================================================================
# CittaEFS Multi-Tenant Integration Hub - Environment Configuration
# ============================================================================
# 
# DEPLOYMENT ARCHITECTURE:
# - BACKEND API SERVER: Runs on Render.com (Node.js Express server)
# - FRONTEND: Built with Vite and deployed on Vercel (static + API proxy)
# - Vercel's vercel.json proxies all /api/* requests to Render backend
#
# CREDENTIAL STORAGE:
# - All sensitive credentials below should be stored in RENDER SECRET FILES
# - Render Secret Files are NOT version controlled and stored securely
# - Access at runtime: process.env or from /etc/secrets/<filename>
# - Do NOT commit actual values to this repository
# - Local development: Copy this file to .env and fill in placeholder values
# ============================================================================

# ============================================================================
# CORE SERVER CONFIGURATION
# ============================================================================
NODE_ENV=production
PORT=3000

# JWT Secret for token signing (generate a secure random string)
# Example: openssl rand -base64 32
# STORE IN: Render Secret Files as .env
JWT_SECRET="your-secure-jwt-secret-here"

JWT_REFRESH_SECRET="your-secure-jwt-refresh-secret-here"

# Encryption key for credential storage (32 bytes hex-encoded)
# Example: openssl rand -hex 32
# STORE IN: Render Secret Files as .env
ENCRYPTION_KEY="your-32-byte-hex-encryption-key"

# ============================================================================
# DATABASE CONFIGURATION (Render PostgreSQL)
# ============================================================================
# Format: postgresql://username:password@host:port/database
# Example: postgresql://cittaefs:password@cittaefs-db.onrender.com:5432/cittaefs_hub
# STORE IN: Render Secret Files as .env (automatically injected by Render)
DATABASE_URL="postgresql://cittaefs:localdev_password@localhost:5432/cittaefs_hub"

# ============================================================================
# BACKEND SERVER URL (Used by frontend for API calls)
# ============================================================================
# Local Development: http://localhost:3000
# Production (Render): https://cittaefs-multi-client-integration-hub.onrender.com
APP_URL="http://localhost:3000"

# ============================================================================
# AI / LLM INTEGRATION (Google Gemini AI)
# ============================================================================
# Get your API key from: https://aistudio.google.com/app/apikey
# Required for Gemini AI features
# STORE IN: Render Secret Files as .env
GEMINI_API_KEY="your-gemini-api-key-here"

# ============================================================================
# CITTAEFS GATEWAY CREDENTIALS (Global)
# ============================================================================
# API key for CittaEFS services
# STORE IN: Render Secret Files as .env
CITTAEFS_API_KEY="citta_live_placeholder"

# Webhook secret for validating incoming CittaEFS webhooks
# STORE IN: Render Secret Files as .env
CITTAEFS_WEBHOOK_SECRET="whsec_placeholder"

# ============================================================================
# QUICKBOOKS ONLINE (QBO) INTEGRATION CREDENTIALS
# ============================================================================
# OAuth2 credentials for QuickBooks Online API
# Register app at: https://developer.intuit.com/
# STORE IN: Render Secret Files as .env
QBO_CLIENT_ID="your-qbo-client-id"
QBO_CLIENT_SECRET="your-qbo-client-secret"
QBO_REDIRECT_URI="https://your-render-domain.onrender.com/api/connectors/qbo/callback"

# ============================================================================
# DEFAULT ADMIN USER (First-time setup only)
# ============================================================================
# ⚠️  IMPORTANT: Change these values before production deployment!
# These credentials will be used to seed the initial admin user.
# STORE IN: Render Secret Files as .env
DEFAULT_ADMIN_EMAIL="admin@cittaefs.com"
DEFAULT_ADMIN_PASSWORD="Admin123!"
DEFAULT_ADMIN_NAME="System Administrator"
DEFAULT_ADMIN_ORG="CittaEFS Enterprise"

# ============================================================================
# OPTIONAL: DEFAULT OPERATOR USER
# ============================================================================
# Uncomment to create an operator user during database seeding
# DEFAULT_OPERATOR_EMAIL="operator@cittaefs.com"
# DEFAULT_OPERATOR_PASSWORD="OperatorPass123!"
# DEFAULT_OPERATOR_NAME="System Operator"
# DEFAULT_OPERATOR_ORG="Default Organization"

# ============================================================================
# OPTIONAL: LEGACY CLOUD SQL INTEGRATION (Google Cloud)
# ============================================================================
# These are only needed if you're using Google Cloud SQL for hosted databases
# SQL_HOST=
# SQL_USER=
# SQL_PASSWORD=
# SQL_DB_NAME=
# SQL_ADMIN_USER=
# SQL_ADMIN_PASSWORD=
